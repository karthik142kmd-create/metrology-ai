# MetrologyAI - Environment Variables
# Copy this file to .env and update the values

# Database
DATABASE_URL=sqlite:///./metrology.db
# For PostgreSQL: postgresql://user:password@localhost/metrology_db

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# Reports
REPORT_DIR=reports

# OCR Provider
# Options: "auto", "tesseract", "demo"
OCR_PROVIDER=auto

# Application
APP_NAME=MetrologyAI
APP_SUBTITLE=AI-Assisted Packaged Commodity Compliance Inspection
DEBUG=False
